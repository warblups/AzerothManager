<Application x:Class="AzerothManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AzerothManager.ViewModels"
             xmlns:views="clr-namespace:AzerothManager.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <views:NotBoolConverter x:Key="NotBool" />
            <views:QualityToBrushConverter x:Key="QualityToBrush" />
            <views:DisplayIdToIconConverter x:Key="DisplayIdToIcon" />

            <!-- Association ViewModel -> Vue -->
            <DataTemplate DataType="{x:Type vm:ServerConfigViewModel}">
                <views:ServerConfigView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GmConsoleViewModel}">
                <views:GmConsoleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SqlEditorViewModel}">
                <views:SqlEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemCatalogViewModel}">
                <views:ItemCatalogView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
