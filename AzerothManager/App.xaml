<Application x:Class="AzerothManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AzerothManager.ViewModels"
             xmlns:views="clr-namespace:AzerothManager.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Association ViewModel -> Vue -->
            <DataTemplate DataType="{x:Type vm:ServerConfigViewModel}">
                <views:ServerConfigView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
