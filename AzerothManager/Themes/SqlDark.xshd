<?xml version="1.0" encoding="utf-8"?>
<!--
  Coloration SQL pour fond sombre. La définition TSQL fournie par AvalonEdit vise
  un fond blanc (bleu marine, rouge sombre) et devient illisible sur #0d1117.
-->
<SyntaxDefinition name="SqlDark" extensions=".sql"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Comment"     foreground="#6A9955" />
  <Color name="String"      foreground="#CE9178" />
  <Color name="Number"      foreground="#B5CEA8" />
  <Color name="Keyword"     foreground="#569CD6" fontWeight="bold" />
  <Color name="Destructive" foreground="#E94560" fontWeight="bold" />
  <Color name="Function"    foreground="#DCDCAA" />
  <Color name="Type"        foreground="#4EC9B0" />
  <Color name="Operator"    foreground="#D4D4D4" />

  <RuleSet ignoreCase="true">

    <Span color="Comment" begin="--" />
    <Span color="Comment" begin="#" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />

    <Span color="String" begin="'" end="'">
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="&quot;" end="&quot;" />
    <Span color="Type" begin="`" end="`" />

    <!-- Mots-clés destructifs mis en évidence : voir la requête avant de la lancer -->
    <Keywords color="Destructive">
      <Word>DELETE</Word>
      <Word>DROP</Word>
      <Word>TRUNCATE</Word>
      <Word>ALTER</Word>
      <Word>UPDATE</Word>
      <Word>REPLACE</Word>
    </Keywords>

    <Keywords color="Keyword">
      <Word>SELECT</Word><Word>FROM</Word><Word>WHERE</Word><Word>INSERT</Word>
      <Word>INTO</Word><Word>VALUES</Word><Word>SET</Word><Word>JOIN</Word>
      <Word>INNER</Word><Word>LEFT</Word><Word>RIGHT</Word><Word>OUTER</Word>
      <Word>ON</Word><Word>AS</Word><Word>AND</Word><Word>OR</Word><Word>NOT</Word>
      <Word>NULL</Word><Word>IS</Word><Word>IN</Word><Word>LIKE</Word><Word>BETWEEN</Word>
      <Word>ORDER</Word><Word>BY</Word><Word>GROUP</Word><Word>HAVING</Word>
      <Word>LIMIT</Word><Word>OFFSET</Word><Word>DISTINCT</Word><Word>UNION</Word>
      <Word>CREATE</Word><Word>TABLE</Word><Word>INDEX</Word><Word>VIEW</Word>
      <Word>DATABASE</Word><Word>PRIMARY</Word><Word>KEY</Word><Word>FOREIGN</Word>
      <Word>REFERENCES</Word><Word>DEFAULT</Word><Word>AUTO_INCREMENT</Word>
      <Word>CASE</Word><Word>WHEN</Word><Word>THEN</Word><Word>ELSE</Word><Word>END</Word>
      <Word>ASC</Word><Word>DESC</Word><Word>EXISTS</Word><Word>ALL</Word><Word>ANY</Word>
      <Word>BEGIN</Word><Word>COMMIT</Word><Word>ROLLBACK</Word><Word>TRANSACTION</Word>
      <Word>SHOW</Word><Word>DESCRIBE</Word><Word>EXPLAIN</Word><Word>USE</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>INT</Word><Word>INTEGER</Word><Word>TINYINT</Word><Word>SMALLINT</Word>
      <Word>MEDIUMINT</Word><Word>BIGINT</Word><Word>FLOAT</Word><Word>DOUBLE</Word>
      <Word>DECIMAL</Word><Word>VARCHAR</Word><Word>CHAR</Word><Word>TEXT</Word>
      <Word>BLOB</Word><Word>DATE</Word><Word>DATETIME</Word><Word>TIMESTAMP</Word>
      <Word>UNSIGNED</Word><Word>ENUM</Word>
    </Keywords>

    <Keywords color="Function">
      <Word>COUNT</Word><Word>SUM</Word><Word>AVG</Word><Word>MIN</Word><Word>MAX</Word>
      <Word>CONCAT</Word><Word>SUBSTRING</Word><Word>REPLACE</Word><Word>NOW</Word>
      <Word>UNIX_TIMESTAMP</Word><Word>FROM_UNIXTIME</Word><Word>IFNULL</Word>
      <Word>COALESCE</Word><Word>CAST</Word><Word>CONVERT</Word><Word>LENGTH</Word>
      <Word>UPPER</Word><Word>LOWER</Word><Word>TRIM</Word><Word>ROUND</Word>
    </Keywords>

    <Rule color="Number">\b0[xX][0-9a-fA-F]+|\b\d+(\.\d+)?</Rule>
    <Rule color="Operator">[?,.;()\[\]{}+\-/%*&lt;&gt;^+~!|&amp;=]+</Rule>

  </RuleSet>
</SyntaxDefinition>
