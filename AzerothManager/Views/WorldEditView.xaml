<UserControl x:Class="AzerothManager.Views.WorldEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍  Chercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding SearchCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Width="170" Margin="8,0,0,0">
                    <TextBlock Text="Carte" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding Map}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Width="190" Margin="0,0,8,0">
                    <TextBlock Text="Table" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nom, identifiant de modèle ou guid" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <!--
                Pas de bouton .reload ici, contrairement aux autres modules qui écrivent
                dans world : cs_reload.cpp ne recharge que les modèles, pas les spawns.
                Proposer un .reload inerte serait pire que de ne rien proposer.
            -->
            <Border Grid.Row="1" Background="#3d2f10" BorderBrush="{StaticResource Warning}"
                    BorderThickness="1" Padding="8,5" Margin="0,0,0,8" CornerRadius="4"
                    Visibility="{Binding RestartPending, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap"
                           Text="Spawns modifiés en base. Aucune commande ne recharge les spawns — ni .reload creature, ni .reload gameobject : le monde en jeu ne changera qu'au prochain redémarrage du worldserver." />
            </Border>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Spawns}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Guid" Binding="{Binding Guid}" Width="80" />
                    <DataGridTextColumn Header="Modèle" Binding="{Binding Entry}" Width="75" />
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="Nom anglais" Binding="{Binding NameEnglishText}" Width="1*" MinWidth="110" />
                    <DataGridTextColumn Header="Zone" Binding="{Binding ZoneText}" Width="170" />
                    <DataGridTextColumn Header="Carte" Binding="{Binding MapName}" Width="130" />
                    <DataGridTextColumn Header="Position" Binding="{Binding PositionText}" Width="170" />
                    <DataGridTextColumn Header="Réapparition" Binding="{Binding SpawnTimeText}" Width="95" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <Button DockPanel.Dock="Left" Content="◀" Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" />
                <Button DockPanel.Dock="Left" Content="▶" Command="{Binding NextPageCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding PageLabel}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="Spawn sélectionné" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding Selected.KindText, Mode=OneWay}" />
                            <Run Text=" « " /><Run Text="{Binding Selected.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" » — guid " />
                            <Run Text="{Binding Selected.Guid, Mode=OneWay}" />
                            <Run Text=", modèle " /><Run Text="{Binding Selected.Entry, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="{Binding Selected.ZoneText, Mode=OneWay}" />
                            <Run Text=" — " /><Run Text="{Binding Selected.MapName, Mode=OneWay}" />
                        </TextBlock>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Z" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditZ, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Orientation" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditOrientation, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Réapparition (s)" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditSpawnTime, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Commentaire" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding EditComment, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="46"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="💾  Appliquer" Style="{StaticResource SuccessButton}"
                                    Command="{Binding ApplyCommand}" />
                            <Button Content="🗑  Supprimer le spawn" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ce que ce module ne peut pas faire" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Placer un PNJ ou un objet, le déplacer à l'endroit où l'on se trouve, poser un waypoint : .npc add, .npc move, .gobject add et .wp add relèvent la position du personnage qui les exécute. Elles exigent une session en jeu et ne sont pas disponibles par SOAP. On modifie donc ici des spawns existants, avec des coordonnées saisies." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Et aucune commande ne recharge les spawns : cs_reload.cpp couvre les modèles (creature_template, gameobject_template…), pas creature ni gameobject. Toute modification faite ici n'apparaît en jeu qu'après un redémarrage du worldserver." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Pourquoi la zone est déduite" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Les colonnes zoneId et areaId de creature et gameobject sont des caches remplis au besoin par le serveur : elles valent 0 pour la quasi-totalité des spawns. La zone affichée est donc calculée depuis la position, avec les rectangles d'AreaTable.dbc — comme sur la carte des joueurs. Elle exige que les DBC aient été importés." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
