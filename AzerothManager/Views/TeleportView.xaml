<UserControl x:Class="AzerothManager.Views.TeleportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍  Chercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Width="180" Margin="8,0,0,0">
                    <TextBlock Text="Carte" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding Map}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nom de la destination" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoadCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <!-- Rappel du .reload, comme dans la console SQL -->
            <Border Grid.Row="1" Background="#3d2f10" BorderBrush="{StaticResource Warning}"
                    BorderThickness="1" Padding="8,5" Margin="0,0,0,8" CornerRadius="4"
                    Visibility="{Binding ReloadPending, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="▶  Exécuter" Style="{StaticResource WarningButton}"
                            Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
                    <TextBlock TextWrapping="Wrap"
                               Text="La bibliothèque a été modifiée : le serveur ne connaîtra les nouvelles destinations qu'après un .reload game_tele." />
                </DockPanel>
            </Border>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Points}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="Carte" Binding="{Binding MapName}" Width="170" />
                    <DataGridTextColumn Header="Position" Binding="{Binding PositionText}" Width="190" />
                    <DataGridTextColumn Header="Orient." Binding="{Binding OrientationText}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Point de destination" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Le nom sert d'identifiant à la commande : il ne doit pas contenir d'espace, sinon elle n'en lira que le premier mot." />

                        <TextBlock Text="Nom" Style="{StaticResource Caption}" Margin="0,6,0,2" />
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Carte" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding EditMap, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Z" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding EditZ, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Orientation" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding EditOrientation, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="➕  Ajouter" Style="{StaticResource SuccessButton}"
                                    Command="{Binding AddCommand}" />
                            <Button Content="💾  Modifier" Command="{Binding UpdateCommand}"
                                    IsEnabled="{Binding HasSelection}" />
                            <Button Content="🗑" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}"
                                    Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="Envoyer un personnage" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="Vers " /><Run Text="{Binding Selected.Name, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="🌀  Envoyer" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SendCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding TeleportTarget, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nom du personnage" Margin="0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Pourquoi saisir les coordonnées" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="La commande .tele add relève la position du maître de jeu qui l'exécute : elle exige donc une session en jeu et n'est pas disponible par SOAP. L'ajout se fait ici en base, avec des coordonnées saisies — plus précis, mais à vous de les connaître." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
