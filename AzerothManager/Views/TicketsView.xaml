<UserControl x:Class="AzerothManager.Views.TicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="🔄  Charger" Style="{StaticResource SuccessButton}" Command="{Binding LoadCommand}" />
                <CheckBox Content="Ouverts seulement" IsChecked="{Binding OpenOnly}" VerticalAlignment="Center" />
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Tickets}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="55" />
                    <DataGridTextColumn Header="Joueur" Binding="{Binding PlayerName}" Width="110" />
                    <DataGridTextColumn Header="Statut" Binding="{Binding StateText}" Width="85" />
                    <DataGridTextColumn Header="Assigné à" Binding="{Binding AssignedText}" Width="100" />
                    <DataGridTextColumn Header="Résumé" Binding="{Binding Summary}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedText}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <!-- Traitement du ticket -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding HasSelection}">
            <StackPanel>
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}">
                            <Run Text="Ticket " /><Run Text="{Binding Selected.Id, Mode=OneWay}" />
                            <Run Text=" — " /><Run Text="{Binding Selected.PlayerName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding Selected.StateText, Mode=OneWay}" />
                            <Run Text="  ·  joueur " /><Run Text="{Binding Selected.OnlineText, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Selected.CreatedText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="{Binding Selected.PositionText}" />

                        <TextBlock Text="Description" Style="{StaticResource SectionTitle}" />
                        <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderB}"
                                BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Réponse déjà envoyée" Style="{StaticResource Caption}" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding Selected.Response, FallbackValue='—'}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Success}" />

                        <TextBlock Text="Commentaire interne" Style="{StaticResource Caption}" Margin="0,6,0,2" />
                        <TextBlock Text="{Binding Selected.Comment, FallbackValue='—'}" TextWrapping="Wrap"
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Aller voir : dépend d'un personnage GM connecté -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Intervenir en jeu" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Ces trois commandes agissent sur le personnage maître de jeu qui les exécute : il doit être connecté." />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="🌀  Aller sur place" Command="{Binding GoToCommand}" />
                            <Button Content="Rejoindre" Command="{Binding AppearCommand}" />
                            <Button Content="Invoquer" Command="{Binding SummonCommand}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Traitement -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Réponse au joueur" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding ResponseText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Envoyer la réponse" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RespondCommand}" />
                            <Button Content="✅  Marquer traité" Style="{StaticResource SuccessButton}"
                                    Command="{Binding CompleteCommand}" Margin="0" />
                        </StackPanel>

                        <TextBlock Text="Commentaire interne" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ajouter" Margin="6,0,0,6"
                                    Command="{Binding CommentCommand}" />
                            <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Text="Assignation" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Retirer" Margin="6,0,0,6"
                                    Command="{Binding UnassignCommand}" />
                            <Button DockPanel.Dock="Right" Content="Assigner" Margin="6,0,0,6"
                                    Command="{Binding AssignCommand}" />
                            <TextBox Text="{Binding AssignTo, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nom du personnage maître de jeu" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Escalader" Command="{Binding EscalateCommand}" />
                            <Button Content="Clore" Command="{Binding CloseCommand}" />
                            <Button Content="🗑  Supprimer" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
