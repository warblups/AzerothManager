<UserControl x:Class="AzerothManager.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Recherche de personnage -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍" Style="{StaticResource SuccessButton}"
                        Command="{Binding SearchCommand}" VerticalAlignment="Bottom" Margin="6,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="En ligne" IsChecked="{Binding OnlyOnline}"
                          VerticalAlignment="Bottom" Margin="6,0,0,6" />
                <StackPanel>
                    <TextBlock Text="Nom du personnage" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" MinWidth="90" />
                    <DataGridTextColumn Header="Niv" Binding="{Binding Level}" Width="40" />
                    <DataGridTextColumn Header="" Binding="{Binding StateText}" Width="65" />
                    <DataGridTextColumn Header="Compte" Binding="{Binding AccountName}" Width="85" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Inventaire du personnage sélectionné -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderB}" BorderThickness="1" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0"
                               Text="{Binding Selected.Name, FallbackValue=—}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="{Binding Summary}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{Binding OnlineText}" />
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" IsEnabled="{Binding HasSelection}">

                <TabItem Header="Objets">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Section" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nom ou numéro de modèle" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                                  EnableRowVirtualization="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="24" Height="24"
                                                   Source="{Binding DisplayId, Converter={StaticResource DisplayIdToIcon}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Objet" Binding="{Binding Name}" Width="*" MinWidth="170">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Qté" Binding="{Binding Count}" Width="45" />
                                <DataGridTextColumn Header="Section" Binding="{Binding SectionText}" Width="95" />
                                <DataGridTextColumn Header="Emplacement" Binding="{Binding Place}" Width="1.3*" MinWidth="160" />
                                <DataGridTextColumn Header="Niv." Binding="{Binding ItemLevel}" Width="45" />
                                <DataGridTextColumn Header="" Binding="{Binding BoundText}" Width="35" />
                                <DataGridTextColumn Header="Durab." Binding="{Binding DurabilityText}" Width="60" />
                                <DataGridTextColumn Header="Modèle" Binding="{Binding Entry}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Left" Width="70" Margin="0,0,8,0">
                                <TextBlock Text="Quantité" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Left" Content="➖  Retirer" Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveCommand}" VerticalAlignment="Bottom"
                                    ToolTip="Retire par modèle d'objet, dans toutes les poches et la banque" />
                            <Button DockPanel.Dock="Right" Content="🎁  Donner un objet…" Style="{StaticResource SuccessButton}"
                                    Command="{Binding GiveCommand}" VerticalAlignment="Bottom" Margin="0"
                                    ToolTip="Dans les sacs si le personnage est connecté, par courrier sinon" />
                            <TextBlock />
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Objets archivés">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#3d2f10" BorderBrush="{StaticResource Warning}" BorderThickness="1"
                                CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap" Text="{Binding RecoveryConfig}" />
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Recoveries}" SelectedItem="{Binding SelectedRecovery}"
                                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Width="24" Height="24"
                                                   Source="{Binding DisplayId, Converter={StaticResource DisplayIdToIcon}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Objet" Binding="{Binding Name}" Width="*" MinWidth="170">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Qté" Binding="{Binding Count}" Width="45" />
                                <DataGridTextColumn Header="Perdu le" Binding="{Binding DeletedText}" Width="130" />
                                <DataGridTextColumn Header="Modèle" Binding="{Binding Entry}" Width="60" />
                                <DataGridTextColumn Header="n°" Binding="{Binding Id}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="♻  Restaurer par courrier" Style="{StaticResource SuccessButton}"
                                    Command="{Binding RestoreCommand}" Margin="0" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Un objet vendu reste rachetable au marchand tant que le joueur ne s'est pas déconnecté ; ces emplacements de rachat ne sont jamais écrits en base, ils n'apparaissent donc nulle part ici." />
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</UserControl>
