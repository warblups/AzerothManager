<UserControl x:Class="AzerothManager.Views.GameEventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="↻  Actualiser" Style="{StaticResource SuccessButton}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                        VerticalAlignment="Bottom" Margin="8,0,0,0" ToolTip="F5" />
                <CheckBox DockPanel.Dock="Right" Content="Actifs seulement" IsChecked="{Binding OnlyActive}"
                          VerticalAlignment="Bottom" Margin="12,0,0,6" />
                <StackPanel>
                    <TextBlock Text="Nom ou identifiant d'événement" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                </StackPanel>
            </DockPanel>

            <!-- Aucune commande ne recharge game_event : le rappel remplace le bouton .reload
                 que les autres modules écrivant dans world proposent. -->
            <Border Grid.Row="1" Background="#3d2f10" BorderBrush="{StaticResource Warning}"
                    BorderThickness="1" Padding="8,5" Margin="0,0,0,8" CornerRadius="4"
                    Visibility="{Binding RestartPending, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap"
                           Text="Planification modifiée en base. Il n'existe pas de .reload game_event : le monde en cours ne changera qu'au prochain redémarrage du worldserver." />
            </Border>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Événement" Binding="{Binding Name}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="État" Binding="{Binding ActiveText}" Width="60" />
                    <DataGridTextColumn Header="Période" Binding="{Binding OccurrenceText}" Width="110" />
                    <DataGridTextColumn Header="Durée" Binding="{Binding LengthText}" Width="110" />
                    <DataGridTextColumn Header="Planif." Binding="{Binding ScheduleSourceText}" Width="95"
                                        ToolTipService.ToolTip="D'où le serveur tire réellement la période et la durée" />
                    <DataGridTextColumn Header="Spawns" Binding="{Binding SpawnsText}" Width="90"
                                        ToolTipService.ToolTip="Ajoutés / retirés pendant l'événement" />
                    <DataGridTextColumn Header="Annonce" Binding="{Binding AnnounceText}" Width="105" />
                    <DataGridTextColumn Header="" Binding="{Binding WorldEventText}" Width="65" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="Maintenant" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="{Binding Selected.Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" — événement " /><Run Text="{Binding Selected.Id, Mode=OneWay}" />
                            <Run Text=", spawns " /><Run Text="{Binding Selected.SpawnsText, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="▶  Démarrer" Style="{StaticResource SuccessButton}"
                                    Command="{Binding StartCommand}" />
                            <Button Content="■  Arrêter" Style="{StaticResource WarningButton}"
                                    Command="{Binding StopCommand}" />
                            <Button Content="ℹ" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding InfoCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Effet immédiat sur le monde, mais rien n'est écrit en base : GameEventMgr ne modifie que son état en mémoire. Un redémarrage du worldserver rend la main à la planification." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="Planification" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Début" Style="{StaticResource Caption}" />
                                <DatePicker SelectedDate="{Binding Start}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fin" Style="{StaticResource Caption}" />
                                <DatePicker SelectedDate="{Binding End}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Période (minutes)" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Occurrence, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Durée (minutes)" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <!-- Pour un événement à étape de fête, Holidays.dbc reprend la main
                             au chargement : l'écriture serait sans effet. -->
                        <Border Background="#3d2f10" BorderBrush="{StaticResource Warning}" BorderThickness="1"
                                CornerRadius="4" Padding="8,5" Margin="0,8,0,0"
                                Visibility="{Binding Selected.ScheduleOverriddenByHoliday, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Cet événement porte une étape de fête : le serveur écrase période et durée avec celles de Holidays.dbc à chaque chargement. Les modifier ici resterait sans effet, même après redémarrage — c'est pourquoi la base et .event info peuvent annoncer des durées différentes." />
                        </Border>

                        <Button Content="💾  Enregistrer la planification" Style="{StaticResource SuccessButton}"
                                Command="{Binding SaveScheduleCommand}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Période et durée sont en minutes : 525 600 pour un événement annuel, 20 160 pour une fête de deux semaines. La durée ne peut pas dépasser la période, sans quoi l'événement ne s'arrêterait jamais." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Deux mécanismes à ne pas confondre" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Démarrer ou arrêter agit tout de suite et ne survit pas au redémarrage. Modifier la planification survit au redémarrage mais n'agit qu'à partir de lui. Il n'y a pas de moyen d'obtenir les deux à la fois : c'est la conséquence de l'absence de .reload game_event, cs_reload.cpp ne rechargeant que game_event_npc_vendor." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="L'état « actif » n'est pas calculé depuis la base mais demandé au serveur par .event activelist : un événement lancé à la main ne laisse aucune trace en base, et le recalculer donnerait une réponse fausse." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="La colonne Planif. dit d'où vient réellement la planification. Quand holidayStage n'est pas nul, SetHolidayEventTime remplace période et durée par celles de Holidays.dbc au chargement : la base n'est alors qu'un vestige, et l'écrire ne change rien." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="La colonne Spawns compte ce que l'événement change : à gauche ce qu'il fait apparaître, à droite ce qu'il fait disparaître. Un eventEntry négatif dans game_event_creature ou game_event_gameobject désigne en effet un spawn retiré pendant l'événement." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Réponse du serveur" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MinHeight="70"
                                 FontFamily="Consolas, Courier New" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
