<UserControl x:Class="AzerothManager.Views.SqlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:AzerothManager.Views"
             Background="{StaticResource Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <!-- Onglets de requêtes -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Nouvel onglet (Ctrl+T)" Command="{Binding NewTabCommand}" />
                <Button Content="Fermer" Command="{Binding CloseTabCommand}" />
                <Button Content="Enregistrer en favori" Command="{Binding SaveFavoriteCommand}" />
            </StackPanel>

            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        Background="Transparent" BorderBrush="{StaticResource BorderB}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Barre d'exécution -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,6">
                                <TextBlock Text="Base : " Style="{StaticResource Caption}" />
                                <ComboBox Width="120" Margin="0,0,8,0"
                                          ItemsSource="{Binding Databases}"
                                          SelectedItem="{Binding TargetDatabase}" />
                                <Button Content="Exécuter (Ctrl+Entrée)" Style="{StaticResource AccentButton}"
                                        Command="{Binding ExecuteCommand}" />
                                <Button Content="Exporter CSV" Command="{Binding ExportCsvCommand}" />
                            </StackPanel>

                            <!-- Éditeur -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                                <avalon:TextEditor
                                    views:AvalonEditBehaviour.BindableText="{Binding SqlText, Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="Consolas" FontSize="13"
                                    Background="#FF161617" Foreground="#FFD4D4D4"
                                    ShowLineNumbers="True" WordWrap="True" Padding="4">
                                    <avalon:TextEditor.InputBindings>
                                        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding ExecuteCommand}" />
                                    </avalon:TextEditor.InputBindings>
                                </avalon:TextEditor>
                            </Border>

                            <!-- Bandeau .reload : la règle d'intégration du §9 -->
                            <Border Grid.Row="2" Background="#FF4A3A10" BorderBrush="#FFE0A030" BorderThickness="1"
                                    Padding="8,5" Margin="0,6,0,0"
                                    Visibility="{Binding HasReloadSuggestion, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Exécuter" Margin="8,0,0,0"
                                            Command="{Binding RunReloadCommand}" />
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Écriture dans world : la modification reste invisible tant que" />
                                        <Run Text="{Binding ReloadSuggestion, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                                        <Run Text="n'a pas été exécuté." />
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <!-- Résultat -->
                            <DataGrid Grid.Row="3" Margin="0,6,0,0"
                                      ItemsSource="{Binding Result}"
                                      IsReadOnly="True" AutoGenerateColumns="True"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      Background="#FF161617" RowBackground="#FF1B1B1C"
                                      AlternatingRowBackground="#FF1F1F21"
                                      Foreground="{StaticResource Text}"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{StaticResource BorderB}"
                                      VerticalGridLinesBrush="{StaticResource BorderB}"
                                      BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                                      FontSize="11" RowHeight="20" />

                            <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- Favoris et historique -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Favoris" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
            <Border DockPanel.Dock="Top" Height="200" BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                <ListBox ItemsSource="{Binding Favorites}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" Margin="4,0,0,0"
                                        Command="{Binding DataContext.DeleteFavoriteCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Query}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.LoadCommand,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding Query}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="Historique" Style="{StaticResource SectionTitle}" />
            <Border BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                <ListBox ItemsSource="{Binding History}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.LoadCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
