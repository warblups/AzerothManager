<UserControl x:Class="AzerothManager.Views.MailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rédaction -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Nouveau courrier" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />

                <CheckBox Content="Envoyer à tous les personnages" IsChecked="{Binding SendToAll}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Destinataire (nom du personnage)" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding RecipientEnabled}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Niveau minimum" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding MinLevel, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SendToAll}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Sujet" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Texte" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Or joint" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Or" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Gold, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Argent" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Silver, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Cuivre" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Copper, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="L'or ne peut pas accompagner des objets dans un même courrier : joindre les deux provoque l'envoi de deux courriers." />

                <DockPanel Margin="0,10,0,4">
                    <Button DockPanel.Dock="Right" Content="Vider" Command="{Binding ClearAttachmentsCommand}" Margin="0" />
                    <Button DockPanel.Dock="Right" Content="➕  Ajouter un objet" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddAttachmentCommand}" />
                    <TextBlock Text="Pièces jointes" Style="{StaticResource SectionTitle}" Margin="0" />
                </DockPanel>
                <Border BorderBrush="{StaticResource BorderB}" BorderThickness="1" MinHeight="90">
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="4,0,0,0"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Image DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,6,0"
                                           Source="{Binding DisplayId, Converter={StaticResource DisplayIdToIcon}}" />
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Button Content="✉  Envoyer" Style="{StaticResource SuccessButton}"
                        Command="{Binding SendCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Boîte de réception -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍  Lire" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadInboxCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <StackPanel>
                    <TextBlock Text="Boîte de réception d'un personnage" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding InboxCharacter, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoadInboxCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Inbox}" IsReadOnly="True"
                      AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sujet" Binding="{Binding Subject}" Width="2*" MinWidth="150" />
                    <DataGridTextColumn Header="Objets" Binding="{Binding AttachmentText}" Width="90" />
                    <DataGridTextColumn Header="Or" Binding="{Binding MoneyText}" Width="100" />
                    <DataGridTextColumn Header="Contre-remb." Binding="{Binding CodText}" Width="100" />
                    <DataGridTextColumn Header="Distribué" Binding="{Binding DeliverText}" Width="120" />
                    <DataGridTextColumn Header="Expire" Binding="{Binding ExpireText}" Width="90" />
                    <DataGridTextColumn Header="État" Binding="{Binding StateText}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
