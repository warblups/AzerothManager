<UserControl x:Class="AzerothManager.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍  Chercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <StackPanel>
                    <TextBlock Text="Nom du personnage supprimé (vide pour tout lister)"
                               Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding LoadCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Deleted}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" MinWidth="110" />
                    <DataGridTextColumn Header="Niv" Binding="{Binding Level}" Width="45" />
                    <DataGridTextColumn Header="Race" Binding="{Binding RaceName}" Width="110" />
                    <DataGridTextColumn Header="Classe" Binding="{Binding ClassName}" Width="120" />
                    <DataGridTextColumn Header="Compte d'origine" Binding="{Binding AccountName}" Width="130" />
                    <DataGridTextColumn Header="Supprimé le" Binding="{Binding DeletedText}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Comment ça marche" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="À la suppression, AzerothCore conserve la ligne du personnage et déplace son nom dans deleteInfos_Name. Il reste donc récupérable tant que la purge n'est pas passée — d'où la lecture en SQL, le personnage n'étant plus adressable en jeu." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource Warning}"
                                   Text="Sans rapport avec la suppression d'un compte, qui efface ses personnages en dur : ceux-là n'apparaissent jamais ici." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Name, FallbackValue='Aucune sélection'}"
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="Niveau " /><Run Text="{Binding Selected.Level, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Selected.RaceName, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Selected.ClassName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="Supprimé il y a " /><Run Text="{Binding Selected.DaysSinceDeletion, Mode=OneWay}" />
                            <Run Text=" jour(s)" />
                        </TextBlock>

                        <TextBlock Text="Nouveau nom (si l'ancien est repris)" Style="{StaticResource Caption}"
                                   Margin="0,8,0,2" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Compte de destination (si celui d'origine a disparu)"
                                   Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="♻  Restaurer" Style="{StaticResource SuccessButton}"
                                Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />

                        <TextBlock Text="Effacement définitif" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Retire la ligne pour de bon : le personnage cesse d'être récupérable." />
                        <Button Content="🗑  Effacer définitivement" Style="{StaticResource DangerButton}"
                                Command="{Binding PurgeCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
