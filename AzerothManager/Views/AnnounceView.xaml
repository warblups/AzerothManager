<UserControl x:Class="AzerothManager.Views.AnnounceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshBroadcastsCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Annonce ponctuelle -->
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Annonce immédiate" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="230" Margin="0,0,8,0">
                                <TextBlock Text="Destinataires et forme" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Forms}" SelectedItem="{Binding Form}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="📢  Envoyer" Style="{StaticResource AccentButton}"
                                    Command="{Binding SendAnnounceCommand}" VerticalAlignment="Bottom"
                                    Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Message" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SendAnnounceCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{Binding Form.Effect}" />
                    </StackPanel>
                </Border>

                <!-- Arrêt ou redémarrage planifié -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Arrêt ou redémarrage planifié" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Délai" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Motif annoncé aux joueurs" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <!-- La durée réellement retenue est calculée avec la règle du serveur :
                             « 5 » vaut 5 secondes, « 5m » cinq minutes. -->
                        <TextBlock Text="{Binding DelayPreview}" Style="{StaticResource Caption}" Margin="0,3,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Content="Redémarrer" IsChecked="{Binding Restart}" Margin="0,0,14,0"
                                         VerticalAlignment="Center" />
                            <RadioButton Content="Arrêter" VerticalAlignment="Center" Margin="0,0,14,0">
                                <RadioButton.IsChecked>
                                    <Binding Path="Restart" Converter="{StaticResource NotBool}" />
                                </RadioButton.IsChecked>
                            </RadioButton>
                            <Button Content="⏱  Planifier" Style="{StaticResource WarningButton}"
                                    Command="{Binding ScheduleCommand}" />
                            <Button Content="✖  Annuler le compte à rebours" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelShutdownCommand}" />
                            <Button Content="ℹ  État" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ServerInfoCommand}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Message du jour et fermeture -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Message du jour et accès" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,6" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="90" Margin="0,0,8,0">
                                <TextBlock Text="Locale" Style="{StaticResource Caption}" />
                                <ComboBox ItemsSource="{Binding Locales}" SelectedItem="{Binding MotdLocale}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="💾  Enregistrer" Style="{StaticResource SuccessButton}"
                                    Command="{Binding SetMotdCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="↻  Lire" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ReadMotdCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Message du jour" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding Motd, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="🔒  Fermer aux connexions" Style="{StaticResource DangerButton}"
                                    Command="{Binding CloseServerCommand}" />
                            <Button Content="🔓  Rouvrir" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenServerCommand}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Annonces récurrentes -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="↻  Rafraîchir" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshBroadcastsCommand}" Margin="0" ToolTip="F5" />
                            <TextBlock Text="Annonces récurrentes (auth.autobroadcast)"
                                       Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Ajouter une annonce pendant que la diffusion est coupée ne produit
                             rien : la ligne part en base et reste muette. -->
                        <Border Background="#3d2f10" BorderBrush="{StaticResource Warning}" BorderThickness="1"
                                CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BroadcastConfig.Enabled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" Text="{Binding BroadcastConfig.Summary}" />
                        </Border>

                        <DataGrid ItemsSource="{Binding Broadcasts}" SelectedItem="{Binding SelectedBroadcast}"
                                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                                  MaxHeight="190" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
                                <DataGridTextColumn Header="Poids" Binding="{Binding Weight}" Width="60" />
                                <DataGridTextColumn Header="Royaume" Binding="{Binding RealmText}" Width="70" />
                                <DataGridTextColumn Header="Texte" Binding="{Binding Text}" Width="*" MinWidth="200" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Left" Width="70" Margin="0,0,8,0">
                                <TextBlock Text="Poids" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding BroadcastWeight, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="🗑  Supprimer" Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveBroadcastCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="＋  Ajouter" Style="{StaticResource SuccessButton}"
                                    Command="{Binding AddBroadcastCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Nouvelle annonce récurrente" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding BroadcastText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Réponse brute du serveur -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Réponse du serveur" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MinHeight="60"
                                 FontFamily="Consolas, Courier New" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Arrêter n'arrête pas" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Le serveur de référence tourne sous PM2 avec autorestart activé : .server shutdown fait sortir le processus, et PM2 le relance aussitôt. Arrêt et redémarrage y produisent donc le même résultat — un redémarrage, avec un compte à rebours annoncé aux joueurs. Pour arrêter réellement le worldserver, c'est AzerothUpdater qui s'en charge : le cycle de vie des binaires ne relève pas de cette application (§3)." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Pièges vérifiés aux sources" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Le motif d'un arrêt ne peut pas commencer par un nombre de 0 à 125 : la commande attend un code de sortie facultatif à cette place, et la branche qui le reçoit n'annonce plus aucun motif. Le module refuse plutôt que de laisser le texte disparaître." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Un délai sans suffixe est lu en secondes : « 5 » planifie l'arrêt dans cinq secondes, pas cinq minutes. La durée retenue est affichée avant l'envoi." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Les annonces signées affichent « Console » et non un nom de personnage : elles lisent la session du maître de jeu qui les exécute, et SOAP n'en a aucune." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Le message du jour exige une locale : .server set motd attend un identifiant de royaume facultatif puis la locale. Sans elle, le premier mot du message est pris pour une locale et la commande échoue. En enUS la valeur va dans auth.motd, sinon dans auth.motd_localized." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Une annonce récurrente ajoutée ici est prise en compte immédiatement : la commande recharge elle-même le gestionnaire. La règle « écriture puis .reload » du §9 ne s'applique pas, et proposer un .reload serait redondant." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Fermeture du serveur" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Fermer le serveur refuse les nouvelles connexions sans expulser personne : c'est le geste à faire avant une maintenance, pour vider le royaume progressivement. L'état n'est pas persistant et retombe au redémarrage du worldserver." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
