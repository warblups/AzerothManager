<UserControl x:Class="AzerothManager.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Recherche et liste -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍  Rechercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="8,0,0,6">
                    <CheckBox Content="En ligne" IsChecked="{Binding OnlyOnline}" Margin="0,0,10,0" />
                    <CheckBox Content="Bannis" IsChecked="{Binding OnlyBanned}" Margin="0,0,10,0" />
                    <CheckBox Content="Maîtres de jeu" IsChecked="{Binding OnlyGm}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nom, email, adresse IP ou identifiant" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="55" />
                    <DataGridTextColumn Header="Compte" Binding="{Binding Username}" Width="2*" MinWidth="120" />
                    <DataGridTextColumn Header="État" Binding="{Binding StateText}" Width="85" />
                    <DataGridTextColumn Header="Rang" Binding="{Binding GmLevelText}" Width="140" />
                    <DataGridTextColumn Header="Perso." Binding="{Binding CharacterCount}" Width="55" />
                    <DataGridTextColumn Header="Extension" Binding="{Binding ExpansionName}" Width="150" />
                    <DataGridTextColumn Header="Dernière IP" Binding="{Binding LastIp}" Width="110" />
                    <DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastLoginText}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="◀" Command="{Binding PreviousPageCommand}" />
                    <TextBlock Text="{Binding PageLabel}" Margin="4,0,10,0" />
                    <Button Content="▶" Command="{Binding NextPageCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>

        <!-- Fiche et actions -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Création : ne dépend pas de la sélection -->
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Créer un compte" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Passe obligatoirement par la commande GM : le serveur calcule un couple SRP6 qu'une écriture SQL ne saurait produire." />
                        <TextBlock Text="Nom (16 caractères maximum)" Style="{StaticResource Caption}" Margin="0,6,0,2" />
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Mot de passe (16 maximum, insensible à la casse)" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <TextBlock Text="Email (facultatif)" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="➕  Créer" Style="{StaticResource SuccessButton}"
                                Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Compte sélectionné -->
                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                        IsEnabled="{Binding HasSelection}">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Username, FallbackValue='Aucun compte sélectionné'}"
                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="Créé le " /><Run Text="{Binding Selected.JoinDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                            <Run Text="  ·  " /><Run Text="{Binding Selected.ExpansionName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="Sanction : " /><Run Text="{Binding Selected.BanText, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="Mot de passe" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Appliquer" Margin="6,0,0,6"
                                    Command="{Binding ChangePasswordCommand}" />
                            <TextBox Text="{Binding PasswordChange, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" />
                        </DockPanel>

                        <TextBlock Text="Niveau GM" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Appliquer" Margin="6,0,0,6"
                                    Command="{Binding ApplyGmLevelCommand}" />
                            <ComboBox ItemsSource="{Binding GmLevels}" SelectedItem="{Binding GmLevel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Text="Extension" Style="{StaticResource SectionTitle}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Appliquer" Margin="6,0,0,6"
                                    Command="{Binding ApplyExpansionCommand}" />
                            <ComboBox ItemsSource="{Binding Expansions}" SelectedItem="{Binding Expansion}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Text="Sanction" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding BanDuration, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="10m, 2h, 1d… ou 0 pour un bannissement définitif" />
                            <TextBox Grid.Column="2" Text="{Binding BanReason, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Motif enregistré avec la sanction" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🛡  Bannir" Style="{StaticResource DangerButton}"
                                    Command="{Binding BanCommand}" />
                            <Button Content="Lever" Command="{Binding UnbanCommand}" />
                        </StackPanel>

                        <TextBlock Text="Suppression" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Détruit aussi les personnages du compte, en dur : aucune restauration n'est possible, et une commande GM ne se rejoue pas à l'envers." />
                        <Button Content="🗑  Supprimer le compte" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <TextBlock Text="Personnages" Style="{StaticResource SectionTitle}" />
                        <Border BorderBrush="{StaticResource BorderB}" BorderThickness="1" Height="130">
                            <DataGrid ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Niv" Binding="{Binding Level}" Width="40" />
                                    <DataGridTextColumn Header="Classe" Binding="{Binding ClassName}" Width="100" />
                                    <DataGridTextColumn Header="Or" Binding="{Binding MoneyText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding MuteMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Durée du mute, en minutes" />
                            <TextBox Grid.Column="2" Text="{Binding MuteReason, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Motif, utilisé aussi pour l'expulsion" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔇  Mute" Style="{StaticResource DangerButton}" Command="{Binding MuteCommand}" />
                            <Button Content="Lever" Command="{Binding UnmuteCommand}" />
                            <Button Content="👢  Expulser" Command="{Binding KickCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Mute et expulsion visent un personnage : sélectionnez-le dans la liste ci-dessus. Le joueur doit être connecté pour être expulsé." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
