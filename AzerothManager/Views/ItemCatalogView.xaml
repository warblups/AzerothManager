<UserControl x:Class="AzerothManager.Views.ItemCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nom ou identifiant" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Qualité" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}"
                          DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Catégorie" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding Class}"
                          DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="ilvl min" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding MinLevel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="8">
                <TextBlock Text="ilvl max" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding MaxLevel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="10" VerticalAlignment="Bottom" Orientation="Horizontal">
                <CheckBox Content="Noms français" IsChecked="{Binding FrenchNames}"
                          VerticalAlignment="Center" Margin="0,0,10,6"
                          ToolTip="Noms traduits depuis item_template_locale, avec repli sur l'anglais quand la traduction manque." />
                <Button Content="🔍  Rechercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding SearchCommand}" Margin="0,0,0,6" />
            </StackPanel>
        </Grid>

        <!-- Résultats : le nom prend la couleur de qualité du jeu -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Entry" Binding="{Binding Entry}" Width="70" />
                <DataGridTemplateColumn Header="Nom" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                       Foreground="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nom d'origine" Binding="{Binding NameEn}" Width="200"
                                    FontStyle="Italic" />
                <DataGridTextColumn Header="Qualité" Binding="{Binding QualityName}" Width="90" />
                <DataGridTextColumn Header="ilvl" Binding="{Binding ItemLevel}" Width="55" />
                <DataGridTextColumn Header="Niv. requis" Binding="{Binding RequiredLevel}" Width="75" />
                <DataGridTextColumn Header="Catégorie" Binding="{Binding ClassName}" Width="100" />
                <DataGridTextColumn Header="Emplacement" Binding="{Binding SlotName}" Width="110" />
                <DataGridTextColumn Header="Vente" Binding="{Binding SellPriceText}" Width="100" />
                <DataGridTextColumn Header="Pile" Binding="{Binding Stackable}" Width="50" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination et état -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="◀" Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageLabel}" Margin="4,0,10,0" />
                <Button Content="▶" Command="{Binding NextPageCommand}" />
                <Button Content="📋  Copier l'entry" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyEntryCommand}" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
