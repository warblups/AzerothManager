<UserControl x:Class="AzerothManager.Views.ItemCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nom ou identifiant" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Qualité" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Catégorie" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding Class}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="Type" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Subclasses}" SelectedItem="{Binding Subclass}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="8">
                <TextBlock Text="ilvl min" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding MinLevel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="10">
                <TextBlock Text="ilvl max" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding MaxLevel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="12" VerticalAlignment="Bottom" Orientation="Horizontal">
                <CheckBox Content="Noms français" IsChecked="{Binding FrenchNames}"
                          VerticalAlignment="Center" Margin="0,0,10,6"
                          ToolTip="Noms traduits depuis item_template_locale, avec repli sur l'anglais quand la traduction manque." />
                <Button Content="🔍  Rechercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding SearchCommand}" Margin="0,0,0,6" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Résultats. Le nom prend la couleur de qualité du jeu ; le tri par en-tête
                 est intercepté et délégué au serveur. Double-clic : fiche détaillée. -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Sorting="OnSorting" MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Entry" SortMemberPath="Entry"
                                        Binding="{Binding Entry}" Width="70" />
                    <DataGridTemplateColumn Header="Nom" SortMemberPath="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI"
                                           Foreground="{Binding Quality, Converter={StaticResource QualityToBrush}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nom d'origine" SortMemberPath="NameEn"
                                        Binding="{Binding NameEn}" Width="180" FontStyle="Italic" />
                    <DataGridTextColumn Header="Qualité" SortMemberPath="Quality"
                                        Binding="{Binding QualityName}" Width="90" />
                    <DataGridTextColumn Header="ilvl" SortMemberPath="ItemLevel"
                                        Binding="{Binding ItemLevel}" Width="55" />
                    <DataGridTextColumn Header="Niv. requis" SortMemberPath="RequiredLevel"
                                        Binding="{Binding RequiredLevel}" Width="75" />
                    <DataGridTextColumn Header="Catégorie" SortMemberPath="Class"
                                        Binding="{Binding ClassName}" Width="100" />
                    <DataGridTextColumn Header="Type" SortMemberPath="Subclass"
                                        Binding="{Binding SubclassName}" Width="120" />
                    <DataGridTextColumn Header="Emplacement" SortMemberPath="InventoryType"
                                        Binding="{Binding SlotName}" Width="110" />
                    <DataGridTextColumn Header="Vente" SortMemberPath="SellPrice"
                                        Binding="{Binding SellPriceText}" Width="100" />
                    <DataGridTextColumn Header="Pile" SortMemberPath="Stackable"
                                        Binding="{Binding Stackable}" Width="50" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Fiche détaillée, ouverte au double-clic -->
            <Border Grid.Column="1" Width="330" Margin="10,0,0,0" Padding="12"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderB}"
                    BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding DetailVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Detail}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Padding="7,0" Margin="6,0,0,0"
                                    Command="{Binding DataContext.CloseDetailCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding Summary.Name}" FontSize="14" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Summary.Quality, Converter={StaticResource QualityToBrush}}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Summary.NameEn}" Style="{StaticResource Caption}"
                                   FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,8" />

                        <TextBlock Text="{Binding BondingText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Summary.SlotName}" />
                        <TextBlock Text="{Binding DamageText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DpsText}" Style="{StaticResource Caption}" />

                        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="#1eff00" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ResistanceText}" Foreground="#1eff00" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasResistance, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding Spells}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="#1eff00" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding SocketsText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding HasSockets, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding Description}" Foreground="#ffd100" FontStyle="Italic"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                        <Border BorderBrush="{StaticResource BorderB}" BorderThickness="0,1,0,0"
                                Margin="0,10,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <Run Text="Entry " /><Run Text="{Binding Summary.Entry, Mode=OneWay}" />
                                    <Run Text="  ·  displayid " /><Run Text="{Binding Summary.DisplayId, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <Run Text="ilvl " /><Run Text="{Binding Summary.ItemLevel, Mode=OneWay}" />
                                    <Run Text="  ·  niveau requis " /><Run Text="{Binding Summary.RequiredLevel, Mode=OneWay}" />
                                    <Run Text="  ·  durabilité " /><Run Text="{Binding Durability, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <Run Text="Armure " /><Run Text="{Binding Armor, Mode=OneWay}" />
                                    <Run Text="  ·  vente " /><Run Text="{Binding Summary.SellPriceText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pagination et état -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="◀" Command="{Binding PreviousPageCommand}" />
                <TextBlock Text="{Binding PageLabel}" Margin="4,0,10,0" />
                <Button Content="▶" Command="{Binding NextPageCommand}" />
                <Button Content="📋  Copier l'entry" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CopyEntryCommand}" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
