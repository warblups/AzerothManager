<UserControl x:Class="AzerothManager.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Choix du journal : la liste vient du listage du dossier, pas de noms codés -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔄  Relire" Style="{StaticResource SuccessButton}"
                        Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                        ToolTip="F5" />
                <Button DockPanel.Dock="Right" Content="📁  Chercher les journaux"
                        Style="{StaticResource SecondaryButton}" Command="{Binding RefreshFilesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                        VerticalAlignment="Bottom" Margin="8,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Width="130" Margin="8,0,0,0">
                    <TextBlock Text="Quantité lue" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding Window}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Journal" Style="{StaticResource Caption}" />
                    <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ModifiedText}"
                                               Style="{StaticResource Caption}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <!-- Filtres : appliqués sur la fenêtre déjà lue, sans nouveau transfert -->
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderB}"
                    BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                                VerticalAlignment="Bottom">
                        <Button Content="Problèmes" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ShowProblemsOnlyCommand}"
                                ToolTip="N'afficher que les erreurs et les avertissements" />
                        <Button Content="Tout" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ShowEverythingCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,14,0">
                        <TextBlock Text="Niveaux" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Erreurs" IsChecked="{Binding ShowError}"
                                      Foreground="{StaticResource Error}" Margin="0,0,10,0" />
                            <CheckBox Content="Avertis." IsChecked="{Binding ShowWarning}"
                                      Foreground="{StaticResource Warning}" Margin="0,0,10,0" />
                            <CheckBox Content="Info" IsChecked="{Binding ShowInfo}" Margin="0,0,10,0" />
                            <CheckBox Content="Debug" IsChecked="{Binding ShowDebug}"
                                      Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                            <CheckBox Content="Autres" IsChecked="{Binding ShowOther}" Margin="0,0,14,0" />
                            <CheckBox Content="Mes actions" IsChecked="{Binding ShowAdminActions}"
                                      IsEnabled="{Binding CanCorrelate}"
                                      Foreground="{StaticResource Accent}"
                                      ToolTip="Entrelace les requêtes SQL et les commandes GM de l'historique local" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Rechercher dans les lignes lues" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="{Binding FileHeader}" Style="{StaticResource Caption}"
                       Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

            <DataGrid Grid.Row="3" x:Name="LinesGrid"
                      ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopySelectionCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.RowStyle>
                    <!-- Une seule liaison colore toute la ligne : niveau du journal, ou accent
                         pour une action de l'administrateur. -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground"
                                Value="{Binding Converter={StaticResource LogSeverityToBrush}}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding OriginIcon}" Width="18" />
                    <DataGridTextColumn Header="Heure" Binding="{Binding TimeText}" Width="105" />
                    <DataGridTextColumn Header="Origine" Binding="{Binding Source}" Width="120" />
                    <DataGridTextColumn Header="Niveau" Binding="{Binding SeverityText}" Width="70" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Text}" Width="*" MinWidth="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Text}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="📋  Copier la ligne"
                        Style="{StaticResource SecondaryButton}" Command="{Binding CopySelectionCommand}"
                        Margin="8,0,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Corréler, pas surveiller" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="La lecture en direct d'Auth.log et Server.log appartient à AzerothUpdater, qui suit les fichiers en continu. Ce module fait l'autre moitié du §3 : il lit une fenêtre de la fin du journal et y entrelace l'historique local des requêtes SQL et des commandes GM, pour répondre à « qu'est-ce que le serveur a dit quand j'ai lancé ça ? ». D'où l'absence de rafraîchissement automatique : on consulte, on ne surveille pas." />
                    </StackPanel>
                </Border>

                <!-- Sans horodatage dans les lignes, l'entrelacement n'aurait aucun sens -->
                <Border Padding="8,5" CornerRadius="4" Margin="0,10,0,0" Background="#3d2f10"
                        BorderBrush="{StaticResource Warning}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCorrelate}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Journal sans horodatage" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Aucune ligne lue ne porte de date : l'appender est configuré sans le drapeau d'horodatage. Les actions administrateur ne peuvent donc pas être replacées dans la chronologie. Pour l'activer, ajoutez 1 aux drapeaux de l'appender concerné dans worldserver.conf ou authserver.conf, puis redémarrez." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Où les journaux sont cherchés" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="{Binding SearchedDirectories}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Les noms de fichiers ne sont pas codés en dur : le dossier est listé. Selon les appenders, un serveur écrit Server.log et Auth.log, mais aussi DBErrors.log, Errors.log ou des gm_*.log. Sous PM2, worldserver-error.log est le seul à contenir un plantage survenu avant l'ouverture de Server.log." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ce qui est lu, et ce qui ne l'est pas" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Seule la fin du fichier est transférée — un Server.log dépasse couramment la dizaine de mégaoctets, et le lire entièrement figerait l'interface pour rien. Les filtres s'appliquent à cette fenêtre, pas au fichier complet : l'en-tête au-dessus de la grille indique ce qui a réellement été lu. Pour remonter plus loin, augmentez la quantité lue." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Les horloges de cette machine et du serveur ne sont pas synchronisées à la seconde : les actions administrateur sont récupérées avec une minute de marge de chaque côté de la fenêtre." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
