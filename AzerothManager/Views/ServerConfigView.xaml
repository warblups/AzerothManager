<UserControl x:Class="AzerothManager.Views.ServerConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Liste des profils -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Profils" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="➕  Nouveau" Command="{Binding NewCommand}" />
                <Button Content="🗑  Supprimer" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" />
            </StackPanel>
            <Border BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource Production}" Margin="6,0,0,0" Padding="4,0"
                                            Visibility="{Binding IsProduction, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="PROD" FontSize="10" />
                                    </Border>
                                    <Border Background="{StaticResource Accent}" Margin="6,0,0,0" Padding="4,0"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ACTIF" FontSize="10" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Host}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Détail du profil : deux rangées, pour que la barre d'actions ne recouvre pas les derniers champs -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding HasSelection}">
            <StackPanel DataContext="{Binding Selected}" Margin="0,0,8,0">

                <TextBlock Text="Identification" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nom" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Environnement" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding DataContext.Environments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Environment}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Système" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding DataContext.OperatingSystems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Os}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Adresse" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="MySQL" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Utilisateur" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding MySqlUser, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding MySqlPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mot de passe (chiffré DPAPI à l'enregistrement)" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding MySqlPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Base auth" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding AuthDatabase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Base characters" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding CharactersDatabase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Base world" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding WorldDatabase, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="SSH / SFTP" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Utilisateur" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding SshUser, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mot de passe" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding SshPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

                <TextBlock Text="SOAP — commandes GM" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Compte de jeu de niveau administrateur (gmlevel 3), pas l'utilisateur MySQL."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Compte" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding SoapUser, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding SoapPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mot de passe du compte" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding SoapPassword, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                <CheckBox IsChecked="{Binding SoapThroughSshTunnel}"
                          Content="Passer par un tunnel SSH" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Le tunnel essaie la boucle locale puis l'adresse du serveur, quelle que soit la valeur de SOAP.IP. Il reste indispensable dès que le serveur est accessible depuis l'extérieur, l'authentification SOAP circulant en clair." />

                <TextBlock Text="Chemins sur le serveur" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Racine du serveur" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding ServerPath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Logs" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding LogsPath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="DBC extraits (armurerie)" Style="{StaticResource Caption}" />
                <TextBox Text="{Binding DbcPath, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Mode lecture seule (les services refusent toute écriture)"
                          IsChecked="{Binding ReadOnly}" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Client WoW local : commun à tous les profils, donc hors du DataContext du profil -->
        <Border Grid.Row="1" Margin="0,8,8,0" Padding="10" CornerRadius="4"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderB}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Client WoW local — icônes et noms de sorts" Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Dossier racine du client 3.3.5a, contenant dbc et Interface\Icons. Les données sont importées une fois dans la base locale : le client n'est ensuite plus nécessaire." />
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="📥  Importer" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ImportClientCommand}" Margin="6,0,0,6" />
                    <Button DockPanel.Dock="Right" Content="📂" Command="{Binding BrowseClientCommand}" Margin="6,0,0,6" />
                    <TextBox Text="{Binding ClientPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Text="{Binding ClientStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Barre d'actions + retour de test, en rangée propre sous la zone défilante -->
        <StackPanel Grid.Row="2" Background="{StaticResource Bg}" Margin="0,8,8,0">
            <Border BorderBrush="{StaticResource BorderB}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾  Enregistrer" Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding HasSelection}" />
                        <Button Content="✅  Définir comme actif" Style="{StaticResource SuccessButton}" Command="{Binding ActivateCommand}"
                                IsEnabled="{Binding HasSelection}" />
                        <Button Content="🔌  Tester MySQL" Style="{StaticResource SecondaryButton}" Command="{Binding TestMySqlCommand}"
                                IsEnabled="{Binding HasSelection}" />
                        <Button Content="🔑  Tester SSH" Style="{StaticResource SecondaryButton}" Command="{Binding TestSshCommand}"
                                IsEnabled="{Binding HasSelection}" />
                        <Button Content="⚡  Tester SOAP" Style="{StaticResource SecondaryButton}" Command="{Binding TestSoapCommand}"
                                IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TestOutput}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
