<UserControl x:Class="AzerothManager.Views.PlayerMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding PanelWidth}" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="{Binding PanelToggleLabel}" Margin="8,0,0,0"
                        Command="{Binding TogglePanelCommand}" />
                <Button DockPanel.Dock="Right" Content="🔄  Actualiser" Style="{StaticResource SuccessButton}"
                        Command="{Binding LoadCommand}" Margin="8,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Inclure les déconnectés"
                          IsChecked="{Binding IncludeOffline}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Vue générale"
                          IsChecked="{Binding Overview}" VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip="Les quatre continents côte à côte. Chacun garde sa propre projection : aucune carte mondiale n'est fabriquée." />
                <CheckBox DockPanel.Dock="Right" Content="Effectifs par zone"
                          IsChecked="{Binding ShowZones}" VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip="Décoché, chaque joueur est une pastille. Coché, chaque zone porte ses effectifs Alliance et Horde." />
                <ComboBox Width="200" HorizontalAlignment="Left" Margin="0"
                          ItemsSource="{Binding Continents}" SelectedItem="{Binding Continent}"
                          IsEnabled="{Binding ShowSingle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!-- La carte et les marqueurs partagent le même repère : le Viewbox les
                 met à l'échelle ensemble, donc tout reste aligné. -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderB}" BorderThickness="1"
                    Background="{StaticResource InputBg}" CornerRadius="4">
                <Grid>
                    <Viewbox Stretch="Uniform" Margin="4"
                             Visibility="{Binding ShowSingle, Converter={StaticResource BoolToVis}}">
                        <Canvas Width="{Binding MapWidth}" Height="{Binding MapHeight}">
                            <Image Source="{Binding MapImage}"
                                   Width="{Binding MapWidth}" Height="{Binding MapHeight}" />

                            <!-- Un point par joueur -->
                            <ItemsControl ItemsSource="{Binding Markers}"
                                          Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                                          Visibility="{Binding ShowPlayers, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding MarkerX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding MarkerY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" StrokeThickness="1.5"
                                                 Stroke="#FF101018" ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="20000">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FFE03030" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlliance}" Value="True">
                                                            <Setter Property="Fill" Value="#FF3080E0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Une bulle par zone peuplée : Alliance · Horde -->
                            <ItemsControl ItemsSource="{Binding ZoneBubbles}"
                                          Width="{Binding MapWidth}" Height="{Binding MapHeight}"
                                          Visibility="{Binding ShowZones, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding MarkerX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding MarkerY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Size}" Height="{Binding Size}"
                                                CornerRadius="999" BorderThickness="2"
                                                ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="20000" Opacity="0.93">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DD7A1420" />
                                                    <Setter Property="BorderBrush" Value="#FFE03030" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AllianceMajority}" Value="True">
                                                            <Setter Property="Background" Value="#DD11315E" />
                                                            <Setter Property="BorderBrush" Value="#FF3080E0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontWeight="Bold" FontSize="11">
                                                <Run Text="{Binding Alliance, Mode=OneWay}" Foreground="#FF9BC9FF" />
                                                <Run Text="·" Foreground="#FFBBBBBB" />
                                                <Run Text="{Binding Horde, Mode=OneWay}" Foreground="#FFFFA0A0" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>

                    <!-- Vue générale : les quatre continents côte à côte, chacun avec sa
                         propre projection. Aucune carte mondiale n'est fabriquée. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Overview, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Panels}" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3" Padding="4" CornerRadius="4"
                                            BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}"
                                                           Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Accent}" />
                                            </DockPanel>
                                            <Viewbox Stretch="Uniform">
                                                <Canvas Width="{Binding Width}" Height="{Binding Height}">
                                                    <Image Source="{Binding Image}"
                                                           Width="{Binding Width}" Height="{Binding Height}" />
                                                    <ItemsControl ItemsSource="{Binding Bubbles}"
                                                                  Width="{Binding Width}" Height="{Binding Height}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding MarkerX}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding MarkerY}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding Size}" Height="{Binding Size}"
                                                                        CornerRadius="999" BorderThickness="2"
                                                                        ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="20000" Opacity="0.93">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#DD7A1420" />
                                                                            <Setter Property="BorderBrush" Value="#FFE03030" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding AllianceMajority}" Value="True">
                                                                                    <Setter Property="Background" Value="#DD11315E" />
                                                                                    <Setter Property="BorderBrush" Value="#FF3080E0" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="Bold" FontSize="11">
                                                                        <Run Text="{Binding Alliance, Mode=OneWay}" Foreground="#FF9BC9FF" />
                                                                        <Run Text="·" Foreground="#FFBBBBBB" />
                                                                        <Run Text="{Binding Horde, Mode=OneWay}" Foreground="#FFFFA0A0" />
                                                                    </TextBlock>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                            </Viewbox>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Fond absent : on explique comment le produire plutôt que d'afficher du vide -->
                    <Border Background="#CC1a1a2e" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding MapMissing}" Value="True" />
                                            <Condition Binding="{Binding Overview}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                            <TextBlock Text="Fond de carte absent" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Text="Les fonds de carte sont des ressources du jeu : ils restent sur ce poste et ne sont pas distribués avec l'application. Extrayez-les depuis votre client avec le script fourni." />
                            <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Muted}"
                                       Text="python tools\extract_worldmaps.py &quot;E:\WoW Clients\3.3.5a&quot;" />
                            <Button Content="📂  Ouvrir le dossier des cartes" Margin="0,12,0,0"
                                    HorizontalAlignment="Center" Command="{Binding OpenMapsFolderCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <!-- Toutes les zones peuplées, et les joueurs non projetables -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Text="Toutes les zones peuplées"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <Border BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding AllZones}" IsReadOnly="True"
                              AutoGenerateColumns="False" SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zone" Binding="{Binding ZoneName}" Width="*" />
                            <DataGridTextColumn Header="All." Binding="{Binding Alliance}" Width="42" />
                            <DataGridTextColumn Header="Hor." Binding="{Binding Horde}" Width="42" />
                            <DataGridTextColumn Header="Tot." Binding="{Binding Total}" Width="42" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="Hors des quatre continents" Style="{StaticResource SectionTitle}" />

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Elsewhere}" IsReadOnly="True"
                          AutoGenerateColumns="False" SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Carte" Binding="{Binding MapId}" Width="50" />
                        <DataGridTextColumn Header="Zone" Binding="{Binding ZoneName}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
