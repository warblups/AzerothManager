<UserControl x:Class="AzerothManager.Views.InstanceLocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔍  Chercher" Style="{StaticResource SuccessButton}"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                        VerticalAlignment="Bottom" Margin="8,0,0,0" ToolTip="F5" />
                <CheckBox DockPanel.Dock="Right" Content="Permanents seulement"
                          IsChecked="{Binding OnlyPermanent}" VerticalAlignment="Bottom" Margin="12,0,0,6" />
                <StackPanel>
                    <TextBlock Text="Personnage, ou identifiant de carte" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <!-- Pas de .reload ni de commande : l'effet est reporté au redémarrage. -->
            <Border Grid.Row="1" Background="#3d2f10" BorderBrush="{StaticResource Warning}"
                    BorderThickness="1" Padding="8,5" Margin="0,0,0,8" CornerRadius="4"
                    Visibility="{Binding RestartPending, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap"
                           Text="Verrous supprimés en base. Le worldserver garde en mémoire les liens chargés à son démarrage : les joueurs resteront bloqués jusqu'à son prochain redémarrage." />
            </Border>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Locks}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Personnage" Binding="{Binding CharacterText}" Width="150" />
                    <DataGridTextColumn Header="Niv." Binding="{Binding Level}" Width="50" />
                    <DataGridTextColumn Header="Instance" Binding="{Binding MapText}" Width="*" MinWidth="170" />
                    <DataGridTextColumn Header="Diff." Binding="{Binding Difficulty}" Width="50"
                                        ToolTipService.ToolTip="Donjon : 0 normal, 1 héroïque. Raid : 0 et 1 pour 10 et 25 joueurs, 2 et 3 pour leurs modes héroïques." />
                    <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="95" />
                    <DataGridTextColumn Header="Boss" Binding="{Binding EncountersText}" Width="90" />
                    <DataGridTextColumn Header="Réinit." Binding="{Binding ResetText}" Width="130" />
                    <DataGridTextColumn Header="Restant" Binding="{Binding RemainingText}" Width="90" />
                    <DataGridTextColumn Header="" Binding="{Binding ExtendedText}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                        IsEnabled="{Binding HasSelection}">
                <Button Content="🔓  Lever ce verrou" Style="{StaticResource WarningButton}"
                        Command="{Binding ReleaseSelectedCommand}" />
                <Button Content="🔓  Tous ceux du personnage" Style="{StaticResource WarningButton}"
                        Command="{Binding ReleaseCharacterCommand}" />
                <Button Content="🔓  Toute la carte" Style="{StaticResource DangerButton}"
                        Command="{Binding ReleaseMapCommand}"
                        ToolTip="Pour tous les joueurs, pas seulement ceux affichés" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Padding="10" CornerRadius="4" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Pourquoi le SQL, et pas une commande"
                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Les deux commandes qui feraient le travail, .instance listbinds et .instance unbind, sont Console::No : elles agissent sur le joueur sélectionné ou sur la session du maître de jeu, dont SOAP ne dispose pas. Seule .instance stats est disponible à distance. Le module prend donc l'autre canal du §5, comme l'édition du monde." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Une levée attend le redémarrage" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="InstanceSaveMgr lit toute la table character_instance au démarrage du worldserver et conserve les liens en mémoire pour toute sa durée de vie — pour l'ensemble des personnages, connectés ou non. Supprimer une ligne est donc bien persistant, mais reste invisible en jeu jusqu'au redémarrage suivant." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="C'est plus strict que la règle de l'or d'un personnage, qu'il suffit d'écrire hors ligne : ici, être déconnecté ne change rien." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Les lignes d'instance devenues orphelines ne sont pas supprimées : le serveur les nettoie de lui-même au démarrage. Les effacer ici risquerait d'emporter une instance encore référencée." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Lire la difficulté" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Le chiffre est laissé brut parce qu'il n'a pas le même sens partout : en donjon, 0 vaut normal et 1 héroïque ; en raid, 0 et 1 valent 10 et 25 joueurs, 2 et 3 leurs modes héroïques. Rien dans ces tables ne dit de quel type d'instance il s'agit, et le deviner se tromperait sur les raids sans mode héroïque." />
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="ℹ  État" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StatsCommand}" Margin="0" />
                            <TextBlock Text="Réinitialisations programmées" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Depuis instance_reset. Souvent la vraie réponse à « quand ce raid rouvre-t-il ? », qui évite d'avoir à lever quoi que ce soit." />
                        <DataGrid ItemsSource="{Binding Schedules}" IsReadOnly="True" AutoGenerateColumns="False"
                                  MaxHeight="200" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Instance" Binding="{Binding MapText}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Diff." Binding="{Binding Difficulty}" Width="45" />
                                <DataGridTextColumn Header="Réinit." Binding="{Binding ResetText}" Width="115" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Padding="10" CornerRadius="4" Margin="0,10,0,0" Background="{StaticResource InputBg}"
                        BorderBrush="{StaticResource BorderB}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Réponse du serveur" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MinHeight="60"
                                 FontFamily="Consolas, Courier New" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
