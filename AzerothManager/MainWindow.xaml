<Window x:Class="AzerothManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzerothCore Admin Manager" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Bandeau : le profil Production reste visuellement distinct en continu (§17) -->
        <Border Grid.Row="0" Padding="12,7" BorderBrush="{StaticResource BorderB}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Panel}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Context.IsProduction}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Production}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock Text="AZEROTHCORE ADMIN MANAGER" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Text="{Binding Context.Status}" Foreground="{StaticResource Text}" />
            </DockPanel>
        </Border>

        <!-- Rail de navigation + contenu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource BorderB}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" Margin="0,6">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Version}"
                                           Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="14"
                                           Width="22" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding SelectedItem.Content}" />
        </Grid>

        <!-- Barre d'état : serveur, base, latence, lecture seule (§17) -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12,5"
                BorderBrush="{StaticResource BorderB}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Context.DisplayName}" />
                <TextBlock Text="  │  " Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding Context.Active.CharactersDatabase, FallbackValue=—}" />
                <TextBlock Text="  │  " Foreground="{StaticResource Muted}" />
                <TextBlock Text="{Binding Context.LatencyMs, StringFormat={}{0} ms}" />
                <TextBlock Text="  │  Lecture seule : " Foreground="{StaticResource Muted}" />
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="NON" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Context.IsReadOnly}" Value="True">
                                    <Setter Property="Text" Value="OUI" />
                                    <Setter Property="Foreground" Value="#FFE0A030" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
